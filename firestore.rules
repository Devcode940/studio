rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Admin check via custom claim OR explicit admin UID allowlist (replace with your admin UID in prod via environment)
    // Set admin claim with Firebase Admin SDK: auth.setCustomUserClaims(uid, {admin: true, role: 'admin'})
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.admin == true) ||
        (request.auth.token.role == 'admin')
      );
    }

    // Validate review schema tightly
    function isValidReviewCreate() {
      return request.resource.data.keys().hasAll(['userId', 'userName', 'rating', 'comment', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.userName.size() >= 2 && request.resource.data.userName.size() <= 50
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >= 10 && request.resource.data.comment.size() <= 1000
        && request.resource.data.createdAt == request.time;
    }

    function isValidReviewUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['rating', 'comment', 'updatedAt'])
        && request.resource.data.rating is number
        && request.resource.data.rating >=1 && request.resource.data.rating <=5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >=10;
    }

    // Default: public read, no write. Explicit overrides below.
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Economic data - admin only writes
    match /county_gdp/{gdpId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /census_data/{censusId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Representatives
    match /representatives/{representativeId} {
      allow read: if true;
      allow write: if isAdmin(); // only admins can create/update main doc

      match /performance_metrics/{metricId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /integrity_reports/{reportId} {
        allow read: if true;
        // Only backend / admin should write integrity reports
        allow write: if isAdmin();
      }

      match /highlights/{highlightId} {
        allow read: if true;
        // Highlights should be generated via backend function with rate limiting
        // For now allow admin only; if you want user-triggered, require Cloud Function
        allow create: if isAdmin() 
          && request.resource.data.title is string
          && request.resource.data.description is string
          && request.resource.data.category in ['Achievement', 'Significant Vote', 'Important Statement', 'Project Launch'];
        allow update, delete: if isAdmin();
      }

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn() && isValidReviewCreate();
        allow update: if isOwner(resource.data.userId) && isValidReviewUpdate();
        allow delete: if isOwner(resource.data.userId) || isAdmin();
      }
    }

    match /leaderboard_entries/{leaderboardEntryId} {
      allow read: if true;
      allow write: if isAdmin(); // computed by backend
    }

    // Primary government sources - Auditor General & Attorney General (highest trust 1.5x)
    match /audit_reports/{auditId} {
      allow read: if true;
      allow write: if isAdmin(); // OAG primary source, admin-only ingest
    }

    match /bills/{billId} {
      allow read: if true;
      allow write: if isAdmin(); // AG / Kenya Law primary source
    }

    // Executive accountability – Don't trust executive principle (0.4x lowest)
    match /executive_promises/{promiseId} {
      allow read: if true;
      allow write: if isAdmin(); // Executive promises vs delivery tracker
    }

    match /cob_reports/{cobId} {
      allow read: if true;
      allow write: if isAdmin(); // Controller of Budget independent Art 228, 1.5x vs executive 0.4x
    }

    match /judiciary_checks/{checkId} {
      allow read: if true;
      allow write: if isAdmin(); // Judiciary independent Art 160, executive lost cases
    }

    // Admin audit logs – immutable, no delete
    match /admin_audit/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // immutable audit log for distrust principle
    }

    // Rate limiting for AI generation - track per user
    match /ai_usage/{usageId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
